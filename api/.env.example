# Campaign Notes API example environment
# Copy this file to api/.env for local development.

PORT=3001

# Replace these with strong, unique secrets outside local development.
# Production startup rejects missing, development, or short secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Access tokens should stay short-lived.
ACCESS_TOKEN_TTL=15m

# Refresh tokens should be longer-lived and rotated on use.
REFRESH_TOKEN_TTL=30d

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Typical values: strict, lax, none
COOKIE_SAMESITE=strict

# Comma-separated wiki origins. Same-origin deployments may use the wiki origin
# only; do not use '*' in production because refresh cookies require credentials.
CORS_ORIGINS=http://localhost:5173

# Set to true when the API is behind a reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=false

# Optional: redirect HTTP requests when the API itself receives them. A reverse
# proxy should normally perform the HTTP-to-HTTPS redirect instead.
FORCE_HTTPS=false

# Optional persistent database location for deployments.
DB_PATH=./campaign.db
DB_BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
DB_BUSY_TIMEOUT_MS=5000

# HTTP hardening
REQUEST_BODY_LIMIT=1mb
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300
SHUTDOWN_TIMEOUT_MS=30000

NODE_ENV=development
