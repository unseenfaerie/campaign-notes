# Campaign Notes API example environment
# Copy this file to api/.env for local development.

PORT=3001

# Replace these with strong, unique secrets outside local development.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Access tokens should stay short-lived.
ACCESS_TOKEN_TTL=15m

# Refresh tokens should be longer-lived and rotated on use.
REFRESH_TOKEN_TTL=30d

# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Typical values: strict, lax, none
COOKIE_SAMESITE=strict

NODE_ENV=development
